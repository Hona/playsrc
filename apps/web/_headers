/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), geolocation=(), microphone=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; base-uri 'none'; connect-src 'self' https://assets.playsrc.online; font-src 'self' blob: data:; frame-ancestors 'none'; img-src 'self' blob: data:; media-src 'self' blob: https://assets.playsrc.online; object-src 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:

/tf2/playsrc-config.json
  Cache-Control: no-store

/release.json
  Cache-Control: no-store

/tf2/assets/*
  Cache-Control: public, max-age=31536000, immutable
