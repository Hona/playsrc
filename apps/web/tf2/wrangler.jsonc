{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "playsrc-web",
  "compatibility_date": "2026-07-21",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "playsrc.online",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist/cloudflare",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  }
}
