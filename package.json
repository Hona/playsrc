{
  "name": "playsrc",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": ["packages/*", "packages/presentation/*", "packages/runtime/*", "games/*/browser", "tools/*", "apps/services/*", "apps/web/*"],
  "scripts": {
    "dev": "bun tools/playsrc/src/cli.ts dev",
    "setup": "bun tools/playsrc/src/cli.ts setup",
    "infra:bootstrap": "bun tools/playsrc/src/cli.ts infra bootstrap",
    "infra:plan": "bun tools/playsrc/src/cli.ts infra plan",
    "infra:apply": "bun tools/playsrc/src/cli.ts infra apply",
    "infra:publish": "bun tools/playsrc/src/cli.ts publish",
    "infra:verify": "bun tools/playsrc/src/cli.ts verify deploy",
    "infra:deploy": "bun tools/playsrc/src/cli.ts deploy",
    "generate:tf2-ui": "bun games/tf2/browser/src/ui-resources/generator/generate.ts",
    "build:tf2-wasm-bindings": "bun tools/playsrc/src/build-tf2-wasm-bindings.ts",
    "verify:tf2-wasm": "bun tools/playsrc/src/cli.ts verify tf2-wasm",
    "verify:browser": "bun tools/playsrc/src/cli.ts verify browser",
    "verify:browser-switch": "bun tools/playsrc/src/cli.ts verify browser-switch",
    "verify:displacement-visuals": "bun tools/playsrc/src/cli.ts verify displacement-visuals",
    "diagnose:presentation-bound": "bun tools/playsrc/src/diagnose-presentation-bound.ts",
    "profile:gameui": "playwright test --config=playwright.gameui-profile.config.ts",
    "profile:hud": "playwright test --config=playwright.hud-profile.config.ts",
    "profile:class-hud": "playwright test --config=playwright.class-hud-profile.config.ts",
    "profile:class-selection": "playwright test --config=playwright.class-selection-profile.config.ts",
    "profile:gameplay": "playwright test --config=playwright.profile.config.ts",
    "profile:upward-outdoors": "PROFILE_UPWARD_OUTDOORS=1 playwright test --config=playwright.profile.config.ts",
    "profile:bots": "playwright test --config=playwright.bot-profile.config.ts",
    "profile:engineer": "playwright test --config=playwright.engineer-profile.config.ts",
    "profile:local-practice": "PROFILE_SCENARIOS=local-practice playwright test --config=playwright.profile.config.ts",
    "profile:application-lifecycle": "playwright test --config=playwright.profile.config.ts --grep 'TF2 application generation lifecycle'",
    "profile:map-load": "playwright test --config=playwright.profile.config.ts",
    "profile:cold-map": "playwright test --config=playwright.cold-map-profile.config.ts",
    "profile:map-coverage": "playwright test --config=playwright.coverage-profile.config.ts",
    "profile:startup": "bun tools/playsrc/profile/dev-startup.profile.ts",
    "profile:startup-browser": "playwright test --config=playwright.startup-profile.config.ts",
    "test": "bun test",
    "test:rust": "bun tools/playsrc/src/test-rust.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "wrangler": "4.112.0"
  }
}
